PORT=3000
MONGO_URI=mongodb+srv://UTILISATEUR:MOTDEPASSE@cluster0.xxxxx.mongodb.net/milanostudio?retryWrites=true&w=majority
# Mots de passe : 12 caractères minimum, uniques, jamais partagés. Le serveur refuse de démarrer s'ils sont trop faibles.
ADMIN_KEY=METTEZ-ICI-UN-LONG-MOT-DE-PASSE-UNIQUE
# Clé du monteur : donne accès UNIQUEMENT au suivi « flash prêt / pas prêt » (page /admin, via 3 clics sur le logo)
MONTEUR_KEY=METTEZ-ICI-UN-AUTRE-MOT-DE-PASSE-POUR-LE-MONTEUR
# Nombre maximum de soirées par jour (après, la date n'est plus disponible)
MAX_SOIREES_PER_DAY=3

# Email envoyé à chaque nouvelle réservation
NOTIFY_EMAIL=faresfaleh47@gmail.com
# Compte qui ENVOIE l'email (Gmail) + son "mot de passe d'application" (16 caractères, pas le mot de passe normal)
SMTP_USER=votre.adresse@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# (Optionnel) SMS automatique au client quand vous confirmez sa réservation (compte Twilio payant)
# TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM=+1xxxxxxxxxx

# (Recommandé) SMS automatique avec VOTRE numéro : installez l'application "SMS Gateway for Android" sur votre téléphone,
# activez "Cloud Server" : l'application affiche un identifiant et un mot de passe à recopier ici.
# SMS_GATEWAY_USER=identifiant-affiche-dans-l-application
# SMS_GATEWAY_PASS=mot-de-passe-affiche-dans-l-application
# Mode local (sans internet, même Wi-Fi que le serveur) : SMS_GATEWAY_URL=http://IP-DU-TELEPHONE:8080/messages
# Numéro écrit à la fin des SMS
# STUDIO_SMS_PHONE=92 343 403

# --- Sécurité (en ligne) ---
# Sites autorisés à appeler l'API (adresse de votre site, séparées par des virgules). http://localhost:4200 est autorisé en local.
# ALLOWED_ORIGINS=https://www.monsite.com
# NODE_ENV=production
# Derrière un hébergeur (Render, Railway...) : 1, pour que la limitation par adresse IP fonctionne correctement
# TRUST_PROXY=1
